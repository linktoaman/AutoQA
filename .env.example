# Server Configuration
PORT=3000
NODE_ENV=development

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:e4b

# AI Provider Configuration
# Set AI_PROVIDER=chatgpt to use OpenAI ChatGPT instead of local Ollama.
# Set AI_PROVIDER=gemini to use Google Gemini instead of local Ollama.
#AI_PROVIDER=ollama
#AI_PROVIDER=chatgpt
#AI_PROVIDER=gemini

# OpenAI ChatGPT Configuration (optional)
# Required only when AI_PROVIDER=chatgpt
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=1200

# Gemini Configuration (optional)
# Required only when AI_PROVIDER=gemini
#GEMINI_API_KEY=YOUR_GEMINI_API_KEY
#GEMINI_API_KEY_HEADER=Authorization
#GEMINI_MODEL=gemini-1.5-mini
#GEMINI_API_URL=https://gemini.googleapis.com/v1/models/gemini-1.5-mini:generate
#GEMINI_TEMPERATURE=0.7
#GEMINI_MAX_OUTPUT_TOKENS=1200

